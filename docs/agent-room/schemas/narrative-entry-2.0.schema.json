{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://keaimentor.com/schemas/haip/narrative-entry-2.0.schema.json",
  "title": "HAIP 2.0 Narrative Entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entry_id", "room_id", "speaker_id", "kind", "sequence_start", "sequence_end",
    "text", "confidence", "derived_from_event_ids", "attachments", "actions"
  ],
  "properties": {
    "entry_id": {"type": "string", "pattern": "^nar_[A-Za-z0-9_-]+$"},
    "room_id": {"type": "string", "pattern": "^room_[A-Za-z0-9_-]+$"},
    "task_id": {"type": ["string", "null"], "pattern": "^task_[A-Za-z0-9_-]+$"},
    "speaker_id": {"type": "string", "minLength": 1},
    "kind": {
      "enum": [
        "chat", "delegation", "acknowledgement", "activity", "command_success", "command_failure",
        "file_change", "verification_success", "verification_failure", "blocker", "clarification",
        "approval", "result_submitted", "completed", "failed", "cancelled", "system"
      ]
    },
    "sequence_start": {"type": "integer", "minimum": 1},
    "sequence_end": {"type": "integer", "minimum": 1},
    "text": {"type": "string", "minLength": 1, "maxLength": 4000},
    "tone": {"type": "string"},
    "confidence": {"enum": ["verified", "reported", "inferred", "unknown"]},
    "derived_from_event_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$"},
      "uniqueItems": true
    },
    "attachments": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "actions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
